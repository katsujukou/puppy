parseDeclRecovering :: Array (T.SourceToken) -> Puppy.Runtime.RecoveryResult (T.SourceToken) (C.Decl)
parseDeclRecovering puppyInput =
  puppyFromRecovered
    (Puppy.Runtime.parseRecoveringAt (tableFor 3) (Puppy.Deps.index puppyInput))

parseDeclRecoveringFrom
  :: forall m
   . Puppy.Deps.MonadRec m
  => m (Puppy.Deps.Maybe (T.SourceToken))
  -> m (Puppy.Runtime.RecoveryResult (T.SourceToken) (C.Decl))
parseDeclRecoveringFrom puppyNext =
  map puppyFromRecovered (Puppy.Runtime.parseMRecovering (tableFor 3) puppyNext)
