parseDecl :: Array (T.Token) -> Puppy.Deps.Either (Puppy.Runtime.ParseError (T.Token)) (C.Decl)
parseDecl puppyInput =
  fromResult (runArray puppyInput 0 (Puppy.Runtime.start (tableFor 3)))

