productionAt :: Int -> Puppy.Runtime.ProductionInfo
productionAt puppyIndex = case Puppy.Deps.index productionTable puppyIndex of
  Puppy.Deps.Just puppyFound -> puppyFound
  Puppy.Deps.Nothing -> Puppy.Runtime.internalError
    ("no production " <> show puppyIndex)

